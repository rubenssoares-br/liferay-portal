@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");

			FormsAdmin.teardownForms();

			Navigator.gotoNavItem(navItem = "Element Sets");

			FormsAdmin.teardownElementSets();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "LPS 0000 SF - Create a new form and check if the change still there"
	@priority = 5
	test CreatingNewForm {
		task ("When the user creates a new form") {
			FormsAdmin.addForm();
		}

		task ("Then change the title") {
			Form.editName(formName = "Liferay's Forms");
		}

		task ("And add and edit Text Field") {
			Form.addTextField();

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Text",
				label = "Full Name");

			Form.closeSidebar();
		}

		task ("And add and edit Numeric Field") {
			Form.gotoAddField(
				fieldPositionNumber = 1,
				fieldType = "Numeric");

			Form.editFieldLabelMetal(fieldValue = "Age");
		}

		task ("Then he needs translate the form to Portuguese") {
			Form.addTranslation(localizedLanguage = "Portuguese (Brazil)");

			Form.save();
		}

		task ("And edit TITLE, FULL NAME and AGE") {
			Form.selectTranslation(localizedLanguage = "Portuguese (Brazil)");

			Form.editName(formName = "Forms da Liferay");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Full Name",
				label = "Nome Completo");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Age",
				label = "Idade");

			Form.save();

			Form.publishForm();
		}

		task ("Given publish, he goes Published Form") {
			FormsAdminNavigator.gotoPublishedForm();
		}

		task ("And add information in the english form") {
			FormViewBuilder.editText(
				fieldName = "Full Name",
				fieldValue = "Daniel");

			FormViewBuilder.editText(
				fieldName = "Age",
				fieldValue = 17);

			FormPortlet.clickSubmit();

			Form.submitAgain();
		}

		task ("Then he changes the languag to portuguese language") {
			FormViewBuilder.changeAppLanguageTo(changeAppLanguageTo = "en-US");

			FormViewBuilder.changeAppLanguageTo(changeAppLanguageTo = "português-Brasil");
		}

		task ("Then he put some informations in portuguese forms") {
			FormViewBuilder.editText(
				fieldName = "Nome Completo",
				fieldValue = "Danielzinho");

			FormViewBuilder.editText(
				fieldName = "Idade",
				fieldValue = 18);

			FormPortlet.clickSubmit();

			Form.submitAgain();
		}

		task ("Given the information. He goes back to home") {
			Navigator.openURL();
		}

		task ("And goes back to CONTENT & DATA") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");
		}

		task ("Then open View Entries") {
			FormsAdminNavigator.gotoViewEntries();
		}

		task ("And validate if is visible") {
			LexiconEntry.viewEntryContent(
				key_rowAny = "Daniel",
				key_rowEntry = 17);

			LexiconEntry.viewEntryContent(
				key_rowAny = "Danielzinho",
				key_rowEntry = 18);
		}
	}

	@description = "LPS 0001 - Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
	@priority = 5
	test ValidateConfigurationStringAtControlPanel {
		task ("Given LPS open, the user goes to Aplications Menu") {
			ApplicationsMenuHelper.openApplicationsMenu();
		}

		task ("When is open he goes to Control Panel") {
			ApplicationsMenu.gotoPanel(panel = "Control Panel");
		}

		task ("Then assert if Control Panel is visible") {
			AssertElementPresent(locator1 = "MyTestFile#CONTROL_PANEL");
		}
	}

}